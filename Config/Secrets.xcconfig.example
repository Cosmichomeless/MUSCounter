// Copia este fichero a Secrets.xcconfig (ignorado por git) y rellénalo en local.
// Nunca subas certificados, perfiles ni claves al repositorio.
DEVELOPMENT_TEAM = XXXXXXXXXX

// AdMob (solo Release). Créalos en https://apps.admob.com: la app y un bloque de anuncios tipo banner.
// Si se dejan sin definir se usan los de prueba de Google y scripts/archive.sh se niega a archivar.
ADMOB_APP_ID = ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
ADMOB_BANNER_UNIT_ID = ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ

// Privacidad y soporte (obligatorios para archivar). En xcconfig «//» empieza un comentario: escribe la URL así.
PRIVACY_POLICY_URL = https:/$()/ejemplo.es/privacidad
SUPPORT_EMAIL = soporte@ejemplo.es
